generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Product {
  PLANNER
}

enum CatalogueStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
  DISCARDED
}

/// One design export (a zipped OBJ folder) and the draft `lib/mesh` extracted
/// from it. Immutable — the draft is what the extractor said, never what a
/// human later edited; the human's version is the CatalogueVersion it links to.
model CatalogueImport {
  id            String   @id @default(cuid())
  filename      String
  blobUrl       String
  blobPathname  String
  sizeBytes     Int
  sha256        String   @unique
  sourceVersion String
  draft         Json
  warnings      String[]
  uploadedBy    String
  createdAt     DateTime @default(now())

  versions CatalogueVersion[]
}

/// An immutable-once-published snapshot of one product's catalogue. At most
/// one row per product may have status PUBLISHED — enforced by a partial
/// unique index added by hand in the migration SQL (see migration.sql).
model CatalogueVersion {
  id          String           @id @default(cuid())
  product     Product
  version     Int
  status      CatalogueStatus  @default(DRAFT)
  data        Json
  note        String?
  importId    String?
  import      CatalogueImport? @relation(fields: [importId], references: [id])
  createdBy   String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  publishedBy String?
  publishedAt DateTime?

  @@unique([product, version])
  @@index([product, status])
}

enum CabinetCategory {
  BASE_CABINET
  WALL_CABINET
  TALL_CABINET
  DRAWER_BASE
  FRIDGE_HOUSING
}

enum CabinetRoom {
  KITCHEN
  LIVING_ROOM
  BEDROOM
  FOYER
}

enum CabinetDesignStatus {
  PUBLISHED
  ARCHIVED
}

/// A single named, priced cabinet design uploaded as one `.skp` file. Flat
/// reference catalog, independent of CatalogueVersion — not wired into
/// wardrobe/planner pricing or the viewer.
model CabinetDesign {
  id           String              @id @default(cuid())
  name         String
  filename     String
  blobUrl      String
  blobPathname String
  sizeBytes    Int
  sha256       String              @unique
  category     CabinetCategory
  room         CabinetRoom
  widthMm      Int
  heightMm     Int
  depthMm      Int
  priceRm      Float
  sku          String              @unique
  description  String?
  tags         String?
  finishes     String[]
  status       CabinetDesignStatus @default(PUBLISHED)
  /// The planner family this design was pushed into, once it has been.
  /// Null means the design is library-only and no customer can see it.
  /// Not a relation: families live inside a CatalogueVersion's JSON, not in a
  /// table, so this is a soft reference the publish route writes and the
  /// delete guard reads.
  familyId     String?
  /// The derived render mesh: the drafted geometry, classified by role and
  /// converted to binary at publish time. This is what the planner draws — the
  /// customer sees the model the drafter made, not a box rebuilt from counts.
  ///
  /// Regenerable from `blobPathname` at any time, so it is cache rather than
  /// record: a reader that finds these null falls back to procedural geometry.
  /// The source export stays private; these bytes reach a customer's browser
  /// through `/api/cabinet-mesh/[id]`.
  meshPathname String?
  meshBytes    Int?
  /// Roles and triangle counts, for the review table. The planner does not read
  /// this — the binary is self-describing and carries its own group table.
  meshGroups   Json?
  uploadedBy   String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([status])
  @@index([familyId])
}

/// One marketing photo, keyed by the homepage slot it fills (`hero`,
/// `room:kitchen`, `finish:<finishId>`). Unlike CatalogueVersion there is no
/// draft/publish gate — the design's own copy says a photo is live the moment
/// it's dropped, and a wrong photo is trivially reversible by dropping
/// another. Bytes live in Blob (public, since these render on the public
/// homepage); only the URL is stored here, same rule as CatalogueImport.
model SiteImage {
  key          String   @id
  blobUrl      String
  blobPathname String
  filename     String
  sizeBytes    Int
  uploadedBy   String
  updatedAt    DateTime @updatedAt
}

enum TutorialStatus {
  PROCESSING
  READY
  ERRORED
  ARCHIVED
}

/// One DIY tutorial video. The bytes live at Mux, never here and never in
/// Blob: video needs range requests, transcoding and an adaptive bitrate
/// ladder, and the Blob store is private-access-only so it can only be read
/// back through a function that does none of those things.
///
/// `muxUploadId` is the key rather than `muxAssetId` because it is the only id
/// that exists at the moment the row is created — the asset is minted
/// asynchronously once Mux finishes ingesting, and `/status` fills the rest in.
model Tutorial {
  id          String         @id @default(cuid())
  title       String
  /// Optional: the design makes the video and title the only required fields,
  /// so a tutorial can ship before someone writes the blurb.
  description String         @default("")
  /// Validated against CATEGORY_IDS in lib/tutorials.ts, not a Prisma enum:
  /// this vocabulary is data, and an enum makes adding one a migration.
  category    String
  level       String
  sortOrder   Int            @default(0)
  muxUploadId String         @unique
  muxAssetId  String?
  playbackId  String?
  /// Read off the asset once Mux has it, so nobody hand-types "8 min".
  durationSec Int?
  status      TutorialStatus @default(PROCESSING)
  uploadedBy  String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status, sortOrder])
}
