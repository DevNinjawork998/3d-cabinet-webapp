generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Product {
  PLANNER
}

enum CatalogueStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
  DISCARDED
}

/// One design export (a zipped OBJ folder) and the draft `lib/mesh` extracted
/// from it. Immutable — the draft is what the extractor said, never what a
/// human later edited; the human's version is the CatalogueVersion it links to.
model CatalogueImport {
  id            String   @id @default(cuid())
  filename      String
  blobUrl       String
  blobPathname  String
  sizeBytes     Int
  sha256        String   @unique
  sourceVersion String
  draft         Json
  warnings      String[]
  uploadedBy    String
  createdAt     DateTime @default(now())

  versions CatalogueVersion[]
}

/// An immutable-once-published snapshot of one product's catalogue. At most
/// one row per product may have status PUBLISHED — enforced by a partial
/// unique index added by hand in the migration SQL (see migration.sql).
model CatalogueVersion {
  id          String           @id @default(cuid())
  product     Product
  version     Int
  status      CatalogueStatus  @default(DRAFT)
  data        Json
  note        String?
  importId    String?
  import      CatalogueImport? @relation(fields: [importId], references: [id])
  createdBy   String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  publishedBy String?
  publishedAt DateTime?

  @@unique([product, version])
  @@index([product, status])
}

enum CabinetCategory {
  BASE_CABINET
  WALL_CABINET
  TALL_CABINET
  DRAWER_BASE
  FRIDGE_HOUSING
}

enum CabinetRoom {
  KITCHEN
  LIVING_ROOM
  BEDROOM
  FOYER
}

enum CabinetDesignStatus {
  PUBLISHED
  ARCHIVED
}

/// A single named, priced cabinet design uploaded as one `.skp` file. Flat
/// reference catalog, independent of CatalogueVersion — not wired into
/// wardrobe/planner pricing or the viewer.
model CabinetDesign {
  id           String              @id @default(cuid())
  name         String
  filename     String
  blobUrl      String
  blobPathname String
  sizeBytes    Int
  sha256       String              @unique
  category     CabinetCategory
  room         CabinetRoom
  widthMm      Int
  heightMm     Int
  depthMm      Int
  priceRm      Float
  sku          String              @unique
  description  String?
  tags         String?
  finishes     String[]
  status       CabinetDesignStatus @default(PUBLISHED)
  /// The planner family this design was pushed into, once it has been.
  /// Null means the design is library-only and no customer can see it.
  /// Not a relation: families live inside a CatalogueVersion's JSON, not in a
  /// table, so this is a soft reference the publish route writes and the
  /// delete guard reads.
  familyId     String?
  /// The derived render mesh: the drafted geometry, classified by role and
  /// converted to binary at publish time. This is what the planner draws — the
  /// customer sees the model the drafter made, not a box rebuilt from counts.
  ///
  /// Regenerable from `blobPathname` at any time, so it is cache rather than
  /// record: a reader that finds these null falls back to procedural geometry.
  /// The source export stays private; these bytes reach a customer's browser
  /// through `/api/cabinet-mesh/[id]`.
  meshPathname String?
  meshBytes    Int?
  /// Roles and triangle counts, for the review table. The planner does not read
  /// this — the binary is self-describing and carries its own group table.
  meshGroups   Json?
  uploadedBy   String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([status])
  @@index([familyId])
}

/// One marketing photo, keyed by the homepage slot it fills (`hero`,
/// `room:kitchen`, `finish:<finishId>`). Unlike CatalogueVersion there is no
/// draft/publish gate — the design's own copy says a photo is live the moment
/// it's dropped, and a wrong photo is trivially reversible by dropping
/// another. Bytes live in Blob (public, since these render on the public
/// homepage); only the URL is stored here, same rule as CatalogueImport.
model SiteImage {
  key          String   @id
  blobUrl      String
  blobPathname String
  filename     String
  sizeBytes    Int
  uploadedBy   String
  updatedAt    DateTime @updatedAt
}

enum TutorialStatus {
  PROCESSING
  READY
  ERRORED
  ARCHIVED
}

/// One DIY tutorial video. The bytes live at Mux, never here and never in
/// Blob: video needs range requests, transcoding and an adaptive bitrate
/// ladder, and the Blob store is private-access-only so it can only be read
/// back through a function that does none of those things.
///
/// `muxUploadId` is the key rather than `muxAssetId` because it is the only id
/// that exists at the moment the row is created — the asset is minted
/// asynchronously once Mux finishes ingesting, and `/status` fills the rest in.
model Tutorial {
  id          String         @id @default(cuid())
  title       String
  /// Optional: the design makes the video and title the only required fields,
  /// so a tutorial can ship before someone writes the blurb.
  description String         @default("")
  /// Validated against CATEGORY_IDS in lib/tutorials.ts, not a Prisma enum:
  /// this vocabulary is data, and an enum makes adding one a migration.
  category    String
  level       String
  sortOrder   Int            @default(0)
  muxUploadId String         @unique
  muxAssetId  String?
  playbackId  String?
  /// Read off the asset once Mux has it, so nobody hand-types "8 min".
  durationSec Int?
  status      TutorialStatus @default(PROCESSING)
  uploadedBy  String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status, sortOrder])
}

enum DeliveryStatus {
  DRAFT
  QUOTED
  BOOKED
  DRIVER_ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
  FAILED
}

/// Where a status write came from. A carrier can tell us the same thing twice
/// through two channels — a webhook and the next poll — and when the two
/// disagree it matters which one said what.
enum DeliveryEventSource {
  ADMIN
  CARRIER_WEBHOOK
  POLL
}

/// One delivery job: finished cabinets leaving the workshop for a customer's
/// site, moved by a logistics partner.
///
/// Free-standing on purpose. There is no order, lead or customer table yet
/// (Phase 3), so the admin types the job in. When lead capture lands it
/// pre-fills this form rather than replacing it — a `leadId` column then, not a
/// different model.
model Delivery {
  id                String         @id @default(cuid())
  /// The job number staff say out loud on the phone. Sequential because
  /// "delivery forty-one" is sayable and a cuid is not.
  number            Int            @unique @default(autoincrement())
  customerName      String
  customerPhone     String
  siteAddress       String
  /// Gate codes, unit numbers, "call on arrival" — the things that decide
  /// whether a lorry gets in, kept out of the address line the carrier geocodes.
  addressNotes      String?
  pickupAddress     String
  /// Where the site actually is. Lalamove prices stop to stop by coordinate and
  /// will not take an address string, so a job without a pin cannot be quoted
  /// by a vehicle partner at all.
  ///
  /// `…GeocodedFor` holds the address the pin was resolved for. Comparing it to
  /// the current address is what keeps an edit that only changed the phone
  /// number from re-geocoding, and what marks an admin-typed override as final.
  siteLat           Float?
  siteLng           Float?
  siteGeocodedFor   String?
  pickupLat         Float?
  pickupLng         Float?
  pickupGeocodedFor String?
  /// Line items: `[{ label, qty, widthMm, heightMm, depthMm, weightKg }]`.
  /// Json rather than a table because nothing queries inside it — it is written
  /// whole by the form and read whole by the carrier payload builder.
  items             Json           @default("[]")
  /// Derived from `items` by `lib/logistics/measure.ts`, stored because every
  /// carrier quote wants them and recomputing on each fan-out is pointless.
  totalWeightKg     Float?
  totalVolumeM3     Float?
  scheduledAt       DateTime?
  /// Validated against CARRIER_IDS in lib/logistics/carriers.ts, not a Prisma
  /// enum: same reasoning as `Tutorial.category` — the partner list is data,
  /// and signing a new courier should not be a migration.
  carrierId         String?
  status            DeliveryStatus @default(DRAFT)
  /// The figure the admin saw and confirmed. Kept even after the carrier
  /// invoices differently, because it is what the decision was made on.
  quotedPriceRm     Float?
  /// The carrier's own id for this job. Unique because that uniqueness *is* the
  /// double-book guard: booking spends real money, and a retried request must
  /// not buy a second lorry.
  carrierOrderId    String?        @unique
  trackingUrl       String?
  driverName        String?
  driverPhone       String?
  vehiclePlate      String?
  /// Last known position, as text on the page rather than a map — a map means a
  /// tile provider, a key and bundle weight on a mid-range Android target.
  lastLatitude      Float?
  lastLongitude     Float?
  lastLocationAt    DateTime?
  /// Typed on the confirm step. Admin auth is one shared password with no
  /// per-user identity, so this plus DeliveryEvent is the whole audit story
  /// until accounts exist.
  bookedBy          String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  events DeliveryEvent[]

  @@index([status, scheduledAt])
}

/// Every booking, every status change, every webhook payload we accepted.
/// Doubles as the timeline the detail panel renders — the status column is the
/// current state, this is how it got there.
model DeliveryEvent {
  id         String              @id @default(cuid())
  deliveryId String
  delivery   Delivery            @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  at         DateTime            @default(now())
  source     DeliveryEventSource
  /// Null when the event records something other than a transition — a quote
  /// fan-out, an edit, a failed poll.
  status     DeliveryStatus?
  message    String
  /// Who, when we know: the `bookedBy` name for admin actions, null otherwise.
  actor      String?
  /// The carrier's untouched payload. Kept because the first thing anyone asks
  /// about a wrong status is what the carrier actually sent.
  raw        Json?

  @@index([deliveryId, at])
}

/// What a prepaid carrier last told us was in its wallet.
///
/// One row per carrier, overwritten in place: this is a cache of the last push,
/// not a ledger. Lalamove has no endpoint to ask, so the only way this is ever
/// current is that they told us — which is why `reportedAt` is rendered beside
/// the number wherever it appears.
model CarrierWallet {
  carrierId  String   @id
  /// Null when an event arrived that we could not read a number out of.
  amount     Float?
  currency   String?
  reportedAt DateTime @default(now())
  /// The untouched payload. The event's body is undocumented, so this is how
  /// the real shape gets learned.
  raw        Json?
}
