# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo

# prisma — generated client, regenerate with `pnpm exec prisma generate`
/src/generated/prisma
next-env.d.ts

graphify-out

# Installed agent skills: vendored third-party content (Leonxlnx/taste-skill,
# no upstream licence shipped) plus a machine-local symlink farm under
# .claude/skills. `.agents/skills/skills.md` is ours and stays tracked.
.agents/skills/*/
.claude/skills/
skills-lock.json

# Worktrees for isolated agent work — scratch, never committed.
.claude/worktrees/

# subagent-driven-development scratch — ledger, briefs, review packages
/.superpowers
